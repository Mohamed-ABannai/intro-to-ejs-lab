<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>All Resturaunts</title>

    <link rel="stylesheet" href="/style.css">

</head>

<body>

<%- include('./partialy/nav.ejs') %>

    <h1>All Restaurants </h1>


    <section id="rest-cards-sec">
        
    <% for( let Restaurant of resturaunts ) { %>

        <%
    let status = "- Closed";

    if (Restaurant.isOpen) {
        status = "";
        }
    %>

<div id="res-card">
                
        <a href="/resturaunts/<%=Restaurant.id%>"> <%= Restaurant.name %>  <%= status %></a>
</div>
        <% } %>
        
</section>
</body>

</html>